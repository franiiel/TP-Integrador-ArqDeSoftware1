# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=inspecciones
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=inspecciones
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Dominio del tenant (sin https://)
AUTH0_DOMAIN=inspecciones-obras.us.auth0.com
# Identificador (audience) de la API registrada en Auth0
AUTH0_AUDIENCE=https://inspecciones-obra/api

# --- Datos semilla (pnpm --filter backend seed) ---
# `sub` de Auth0 de cada usuario de prueba (Auth0 > User Management > Users > user_id).
# No es un secreto, pero es un dato personal: no lo subas al repositorio.
SEED_INSPECTOR_AUTH0_ID=google-oauth2|000000000000000000000
# El supervisor no inicia sesión en el caso de uso mínimo: puede quedar este valor ficticio.
SEED_SUPERVISOR_AUTH0_ID=google-oauth2|000000000000000000001

# --- Sistema municipal de expedientes (simulador SOAP) ---
EXPEDIENTES_SOAP_URL=http://localhost:8080/expedientes?wsdl


