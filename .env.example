# Copiar a .env y completar. El archivo .env no se sube al repositorio.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=inspecciones
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=inspecciones
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# --- Auth0 (backend: validación de tokens) ---
# Dominio del tenant, por ejemplo: mi-tenant.us.auth0.com
AUTH0_DOMAIN=
# Identificador (audience) de la API registrada en Auth0
AUTH0_AUDIENCE=

# --- Sistema municipal de expedientes (simulador SOAP) ---
EXPEDIENTES_SOAP_URL=http://localhost:8080/expedientes?wsdl
