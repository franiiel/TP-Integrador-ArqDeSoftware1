erDiagram
    usuarios {
        uuid id PK
        varchar auth0_id UK
        varchar nombre
        varchar email
        enum rol
        varchar cargo "nullable"
        varchar legajo "nullable"
    }
    obras {
        uuid id PK
        varchar direccion
        varchar propietario
        varchar responsable
    }
    expedientes {
        uuid id PK
        int identificador_externo UK
        uuid obra_id FK,UK
    }
    inspecciones {
        uuid id PK
        uuid obra_id FK
        uuid inspector_id FK
        uuid supervisor_id FK
        date fecha
        varchar ubicacion "nullable"
    }
    actas {
        uuid id PK "generado en el celular"
        varchar numero UK "ej. 2026-00001"
        uuid inspeccion_id FK,UK "nullable: solo actas originales"
        uuid expediente_id FK
        timestamptz fecha_emision "fecha legal, del celular"
        timestamptz fecha_hora_recepcion
        text observaciones
        enum tipo_medida "NINGUNA, INTIMACION o CLAUSURA"
        enum tipo_acta "nullable: RECTIFICACION o ANULACION"
        uuid acta_original_id FK "nullable"
        enum estado "PENDIENTE_ASOCIACION o ASOCIADA"
    }
    numeradores_acta {
        int anio PK
        int ultimo_numero
    }
    fotografias {
        uuid id PK
        uuid acta_id FK
        varchar ruta_archivo
    }
    notificaciones {
        uuid id PK
        uuid acta_id FK,UK
        date fecha_emision
        varchar destinatario
        varchar medio
    }

    obras ||--|| expedientes : tiene
    obras ||--o{ inspecciones : recibe
    usuarios ||--o{ inspecciones : "inspector responsable"
    usuarios ||--o{ inspecciones : "supervisor asignante"
    inspecciones |o--o| actas : genera
    expedientes ||--o{ actas : contiene
    actas |o--o{ actas : "rectificacion o anulacion"
    actas ||--|{ fotografias : tiene
    actas ||--|| notificaciones : genera
