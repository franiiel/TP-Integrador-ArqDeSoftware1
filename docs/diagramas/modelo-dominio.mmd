classDiagram
    direction TB

    class Usuario {
        +UUID id
        +String nombre
        +String email
    }
    class Inspector {
        +String cargo
        +String legajo
    }
    class Supervisor {
        +String cargo
        +String legajo
    }
    class Administrativo

    class Obra {
        +UUID id
        +String direccion
        +String propietario
        +String responsable
    }
    class Expediente {
        +int identificadorExterno
    }
    class Inspeccion {
        +UUID id
        +Date fecha
        +String ubicacion
    }
    class Acta {
        +UUID id
        +DateTime fechaEmision
        +String observaciones
        +TipoMedida tipoMedida
        +List~RefArchivo~ fotos
        +TipoRelacion tipoActa
    }
    class Notificacion {
        +UUID id
        +Date fechaEmision
        +String destinatario
        +String medio
    }

    Usuario <|-- Inspector
    Usuario <|-- Supervisor
    Usuario <|-- Administrativo

    Inspector "1" -- "0..*" Inspeccion : responsable
    Supervisor "1" -- "0..*" Inspeccion : asigna
    Obra "1" -- "0..*" Inspeccion : recibe
    Obra "1" -- "1" Expediente : tiene
    Inspeccion "1" -- "1" Acta : genera
    Expediente "1" -- "0..*" Acta : contiene
    Acta "1" -- "0..*" Acta : rectificacion o anulacion
    Acta "1" -- "1" Notificacion : genera
    Acta --> TipoMedida
    Acta --> TipoRelacion
