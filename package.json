{
  "name": "inspecciones-obra",
  "private": true,
  "description": "Sistema de inspecciones de obra municipales · Escenario 2A Municipio chico",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "openapi:lint": "pnpm --package=@redocly/cli dlx redocly lint docs/openapi.yaml",
    "openapi:preview": "pnpm --package=@redocly/cli dlx redocly preview docs/openapi.yaml"
  }
}
